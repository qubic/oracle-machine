# =============================================================================
# Oracle Machine Environment Configuration
# =============================================================================
#
# This file configures the Oracle Machine Node and Oracle Services.
# Usage:
#   Local:  source .env && ./oracle_machine_node
#   Docker: docker compose up (reads .env file setting in docker-compose.yml)
#
# If a variable is not set, the default value from config.h will be used.
# =============================================================================

# -----------------------------------------------------------------------------
# Oracle Machine Node Settings

# Port that Oracle Machine Node listens on for connections from Qubic nodes
export OM_SERVER_PORT=31841

# Qubic Nodes Whitelist
# Comma-separated list of Qubic node IPs allowed to connect to Oracle Machine
# Example: Single node:    QUBIC_NODES=192.168.1.2
#          Multiple nodes: QUBIC_NODES=192.168.1.2,192.168.1.3,192.168.1.4
export QUBIC_NODES=192.168.1.2,192.168.1.3


# Oracle Services Endpoints
# Price Oracle Service
# For Docker: use service name (e.g., price-oracle-service)
# For Local:  use IP address (e.g., 127.0.0.1)
export PRICE_SERVICE_HOST=192.168.1.4
export PRICE_SERVICE_PORT=31842

# Mock Oracle Service
# For Docker: use service name (e.g., mock-oracle-service)
# For Local:  use IP address (e.g., 127.0.0.1)
export MOCK_SERVICE_HOST=192.168.1.5
export MOCK_SERVICE_PORT=31843

# Doge Oracle Service
# For Docker: use service name (e.g., doge-oracle-service)
# For Local:  use IP address (e.g., 127.0.0.1)
export DOGE_SERVICE_HOST=192.168.1.6
export DOGE_SERVICE_PORT=31844

# -----------------------------------------------------------------------------
# GENERIC ORACLE SERVICES
# -----------------------------------------------------------------------------

# read_evm_log Oracle Service (interface index 3): generic single-log EVM read.
# Python service: python3 oracles/read_evm_log/read_evm_log_service.py
# For Docker: use the service name; for Local: use an IP address.
export READ_EVM_LOG_SERVICE_HOST=192.168.1.7
export READ_EVM_LOG_SERVICE_PORT=31845

# read_qubic_log Oracle Service (interface index 4): generic single-log Qubic read.
# Python service: python3 oracles/read_qubic_log/read_qubic_log_service.py
export READ_QUBIC_LOG_SERVICE_HOST=192.168.1.8
export READ_QUBIC_LOG_SERVICE_PORT=31847

# Bob node RPC URL(s) the service reads transaction receipts from, comma-separated. Run your OWN
# bob; all configured bobs must return byte-identical receipts or the service abstains.
# The URL must include the /qubic RPC path (bob answers JSON-RPC only at POST /qubic).
export BOB_URLS=http://127.0.0.1:40420/qubic

# EVM JSON-RPC endpoints per chain id, comma-separated. Use >= 2 independent providers; the
# service only answers when all endpoints agree and only reads finalized state.
export EVM_RPC_URLS_1=https://ethereum-rpc.publicnode.com,https://eth.llamarpc.com
export EVM_RPC_URLS_56=https://bsc-rpc.publicnode.com,https://binance.llamarpc.com

# Ethereum Sepolia testnet (chain id 11155111).
export EVM_RPC_URLS_11155111=https://ethereum-sepolia-rpc.publicnode.com,https://sepolia.drpc.org

# Optional per-chain finality override: (latest - N) instead of the "finalized" tag.
# export EVM_MIN_CONFIRMATIONS_56=30

# -----------------------------------------------------------------------------
# Exchange API Keys (optional - for higher rate limits)
# If not set, free tier with rate limiting will be used.

# Binance API Key
# export BINANCE_API_KEY=your_binance_api_key

# MEXC API Key
# export MEXC_API_KEY=your_mexc_api_key

# Gate.io API Key
# export GATE_API_KEY=your_gate_api_key

# -----------------------------------------------------------------------------
# Docker Settings (only used when running with docker compose)

# User/Group ID for Docker volume permissions
# Run this command to get your IDs: id -u && id -g
# Then uncomment and update the values below:
# export HOST_UID=1000
# export HOST_GID=1000